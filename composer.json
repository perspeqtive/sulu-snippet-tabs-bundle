{
  "name": "perspeqtive/sulu-snippet-tabs-bundle",
  "description": "Organize snippet forms in tabs",
  "type": "sulu-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "PERSPEQTIVE GmbH",
      "email": "mail@perspeqtive.de"
    }
  ],
  "keywords": [
    "sulu",
    "snippet",
    "tabs",
    "admin"
  ],
  "require": {
    "php": "^8.2",
    "sulu/sulu": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "php-cs-fixer/shim": "^3.75",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "symfony/dotenv": "^6.0 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "PERSPEQTIVE\\SuluSnippetTabsBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PERSPEQTIVE\\SuluSnippetTabsBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/runtime": true
    }
  }
}
